{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workflow-platform.example/events/event-envelope-v1.schema.json",
  "title": "Workflow Platform Event Envelope v1",
  "description": "Tenant event envelope. Consumers must ignore unknown optional members.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "tenantId",
    "traceId",
    "schemaVersion",
    "payload"
  ],
  "properties": {
    "eventId": { "$ref": "#/$defs/uuidV7" },
    "eventType": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*){2,}$"
    },
    "occurredAt": { "$ref": "#/$defs/utcInstant" },
    "tenantId": { "$ref": "#/$defs/uuidV7" },
    "traceId": { "$ref": "#/$defs/traceId" },
    "schemaVersion": { "const": 1 },
    "payload": { "type": "object" },
    "producer": {
      "enum": ["control_plane", "scheduler", "worker", "human_task"]
    },
    "subject": { "type": "string", "minLength": 1, "maxLength": 255 },
    "causationId": { "$ref": "#/$defs/uuidV7" },
    "dataContentType": { "const": "application/json" }
  },
  "additionalProperties": true,
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    }
  }
}
