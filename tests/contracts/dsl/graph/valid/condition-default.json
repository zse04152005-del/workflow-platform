{
  "schemaVersion": 1,
  "name": "graph-condition-default",
  "catalogVersion": 1,
  "triggers": [{ "id": "manual", "type": "manual" }],
  "nodes": [
    { "id": "start", "type": "start", "executorVersion": 1 },
    { "id": "decision", "type": "condition", "executorVersion": 1 },
    { "id": "approved", "type": "end", "executorVersion": 1 },
    { "id": "fallback", "type": "end", "executorVersion": 1 }
  ],
  "edges": [
    { "id": "start_decision", "from": "start", "to": "decision", "on": "success" },
    { "id": "approved_route", "from": "decision", "to": "approved", "on": "condition", "when": "input.approved == true" },
    { "id": "fallback_route", "from": "decision", "to": "fallback", "on": "always" }
  ]
}
