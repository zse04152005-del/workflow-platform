{
  "schemaVersion": 1,
  "name": "graph-condition-outdegree",
  "catalogVersion": 1,
  "triggers": [{ "id": "manual", "type": "manual" }],
  "nodes": [
    { "id": "start", "type": "start", "executorVersion": 1 },
    { "id": "decision", "type": "condition", "executorVersion": 1 },
    { "id": "end", "type": "end", "executorVersion": 1 }
  ],
  "edges": [
    { "id": "start_decision", "from": "start", "to": "decision", "on": "success" },
    { "id": "decision_end", "from": "decision", "to": "end", "on": "condition", "when": "input.ok == true" }
  ]
}
