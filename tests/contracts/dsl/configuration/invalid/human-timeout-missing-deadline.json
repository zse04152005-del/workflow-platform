{
  "schemaVersion": 1,
  "name": "human-timeout",
  "catalogVersion": 1,
  "triggers": [{ "id": "manual", "type": "manual" }],
  "nodes": [
    { "id": "start", "type": "start", "executorVersion": 1 },
    {
      "id": "review",
      "type": "human_task",
      "executorVersion": 1,
      "config": {
        "candidateRole": "reviewer",
        "formSchema": { "type": "object" },
        "timeoutPolicy": "fail"
      }
    },
    { "id": "end", "type": "end", "executorVersion": 1 }
  ],
  "edges": [
    { "id": "start_review", "from": "start", "to": "review", "on": "success" },
    { "id": "review_end", "from": "review", "to": "end", "on": "success" }
  ]
}
