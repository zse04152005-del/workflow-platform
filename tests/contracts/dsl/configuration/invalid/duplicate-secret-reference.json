{
  "schemaVersion": 1,
  "name": "duplicate-secret",
  "catalogVersion": 1,
  "triggers": [{ "id": "manual", "type": "manual" }],
  "nodes": [
    { "id": "start", "type": "start", "executorVersion": 1 },
    {
      "id": "call",
      "type": "http",
      "executorVersion": 1,
      "config": {
        "connectorRef": "service.primary",
        "secretRefs": ["service.api_key", "service.api_key"],
        "method": "GET"
      }
    },
    { "id": "end", "type": "end", "executorVersion": 1 }
  ],
  "edges": [
    { "id": "start_call", "from": "start", "to": "call", "on": "success" },
    { "id": "call_end", "from": "call", "to": "end", "on": "success" }
  ]
}
