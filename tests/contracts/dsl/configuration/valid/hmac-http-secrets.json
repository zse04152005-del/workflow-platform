{
  "schemaVersion": 1,
  "name": "signed-delivery",
  "catalogVersion": 1,
  "triggers": [
    {
      "id": "signed_webhook",
      "type": "http",
      "authentication": "hmac",
      "idempotencyRequired": true,
      "hmacSecretRef": "webhook.signing_key"
    }
  ],
  "nodes": [
    { "id": "start", "type": "start", "executorVersion": 1 },
    {
      "id": "deliver",
      "type": "http",
      "executorVersion": 1,
      "config": {
        "connectorRef": "delivery.primary",
        "secretRefs": ["delivery.api_key"],
        "method": "POST",
        "headers": { "X-Request-Id": "input.request_id" },
        "bodyExpression": "input",
        "resultExpression": "response.body"
      }
    },
    { "id": "end", "type": "end", "executorVersion": 1 }
  ],
  "edges": [
    { "id": "start_deliver", "from": "start", "to": "deliver", "on": "success" },
    { "id": "deliver_end", "from": "deliver", "to": "end", "on": "success" }
  ]
}
