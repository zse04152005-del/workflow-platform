    {
      "code": "COMMON_RATE_LIMIT_EXCEEDED",
      "category": "RATE_LIMIT",
      "status": 429,
      "type": "https://api.workflow-platform.example/problems/rate-limit-exceeded",
      "title": "Rate limit exceeded",
      "detail": "The request rate limit has been exceeded.",
      "retryable": true
    },
    {
      "code": "CONNECTOR_DEPENDENCY_UNAVAILABLE",
      "category": "DEPENDENCY",
      "status": 503,
      "type": "https://api.workflow-platform.example/problems/dependency-unavailable",
      "title": "Dependency unavailable",
      "detail": "A required dependency is temporarily unavailable.",
      "retryable": true
    },
    {
      "code": "COMMON_INTERNAL_UNEXPECTED",
      "category": "INTERNAL",
      "status": 500,
      "type": "https://api.workflow-platform.example/problems/unexpected-error",
      "title": "Unexpected server error",
      "detail": "An unexpected error occurred.",
      "retryable": false
    }
  ],
  "sourceBindings": {
    "problemCode": "shared-contracts/src/main/java/com/workflowplatform/contracts/problem/ProblemCode.java",
    "fieldError": "shared-contracts/src/main/java/com/workflowplatform/contracts/problem/FieldValidationError.java",
    "responseFactory": "control-plane/src/main/java/com/workflowplatform/controlplane/api/error/ProblemDetailsResponseFactory.java",
    "exceptionHandler": "control-plane/src/main/java/com/workflowplatform/controlplane/api/error/GlobalProblemDetailsHandler.java",
    "validationMapper": "control-plane/src/main/java/com/workflowplatform/controlplane/api/error/FieldValidationErrorMapper.java"
  },
  "document": "docs/architecture/problem-details-contract.md"
}
