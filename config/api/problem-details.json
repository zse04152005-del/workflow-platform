      "type": "https://api.workflow-platform.example/problems/authorization-denied",
      "title": "Access denied",
      "detail": "The authenticated principal is not allowed to perform this operation.",
      "retryable": false
    },
    {
      "code": "COMMON_NOT_FOUND_RESOURCE",
      "category": "NOT_FOUND",
      "status": 404,
      "type": "https://api.workflow-platform.example/problems/resource-not-found",
      "title": "Resource not found",
      "detail": "The requested resource was not found.",
