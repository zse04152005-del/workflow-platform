{
  "schemaVersion": 1,
  "contractVersion": "1.0.0",
  "reviewedOn": "2026-07-30",
  "task": "G2-09",
  "requirement": "REQ-CONTRACT-001",
  "standard": "RFC 9457",
  "mediaType": "application/problem+json",
  "typeBaseUri": "https://api.workflow-platform.example/problems/",
  "problem": {
    "requiredStandardMembers": ["type", "title", "status", "detail", "instance"],
    "requiredExtensions": ["code", "traceId", "errors", "retryable"],
    "optionalExtensions": ["retryAfterSeconds"],
    "instancePolicy": "request-path-only",
    "queryAllowedInInstance": false,
    "additionalMembersAllowed": false
  },
  "trace": {
    "pattern": "^[0-9a-f]{32}$",
    "allZeroAllowed": false,
    "sourceOrder": ["traceparent", "X-Correlation-ID", "generated"],
    "traceparentPattern": "^(?!ff)[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
    "responseHeader": "X-Trace-Id",
    "invalidInboundAction": "ignore-and-generate",
    "generatedBy": "application-cryptographic-random-128-bit"
  },
  "validation": {
    "errorsProperty": "errors",
    "fieldErrorMembers": ["field", "code", "message"],
    "fieldPathPattern": "^(?:_request|[A-Za-z][A-Za-z0-9_]*(?:\\[(?:0|[1-9][0-9]*)\\]|\\.[A-Za-z][A-Za-z0-9_]*)*)$",
    "fieldCodePattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
    "allowedFieldCodes": ["required", "invalid_format", "invalid_size", "out_of_range", "invalid_type", "invalid"],
    "order": ["field", "code", "message"],
    "maxErrors": 50,
    "rejectedValueAllowed": false,
    "frameworkMessageAllowed": false,
    "messageSource": "curated-static-catalog"
  },
  "headers": {
    "cacheControl": "no-store",
    "authenticationChallenge": "Bearer",
    "retryAfterHeader": "Retry-After"
  },
  "sanitization": {
    "dynamicDetailAllowed": false,
    "internalDetailSource": "static-catalog-only",
    "forbiddenResponseMembers": [
      "rejectedValue",
      "exception",
      "exceptionClass",
      "stackTrace",
      "sql",
      "rawPayload",
      "token",
      "password",
      "secret",
      "authorization",
      "cookie"
    ],
    "logsMayContainStackTrace": true,
    "responseMayContainStackTrace": false
  },
  "categoryStatus": {
    "VALIDATION": 400,
    "AUTHENTICATION": 401,
    "AUTHORIZATION": 403,
    "NOT_FOUND": 404,
    "CONFLICT": 409,
    "PRECONDITION_FAILED": 412,
    "PRECONDITION_REQUIRED": 428,
    "RATE_LIMIT": 429,
    "DEPENDENCY": 503,
    "INTERNAL": 500
  },
  "catalog": [
    {
      "code": "COMMON_VALIDATION_INVALID_FIELD",
      "category": "VALIDATION",
      "status": 400,
      "type": "https://api.workflow-platform.example/problems/invalid-field",
      "title": "Request validation failed",
      "detail": "One or more request fields are invalid.",
      "retryable": false
    },
    {
      "code": "COMMON_VALIDATION_MALFORMED_REQUEST",
      "category": "VALIDATION",
      "status": 400,
      "type": "https://api.workflow-platform.example/problems/malformed-request",
      "title": "Malformed request",
      "detail": "The request body or syntax is malformed.",
      "retryable": false
    },
    {
      "code": "COMMON_VALIDATION_MISSING_PARAMETER",
      "category": "VALIDATION",
      "status": 400,
      "type": "https://api.workflow-platform.example/problems/missing-parameter",
      "title": "Required parameter is missing",
      "detail": "A required request parameter is missing.",
      "retryable": false
    },
    {
      "code": "COMMON_VALIDATION_TYPE_MISMATCH",
