    {
      "code": "DEFINITION_PRECONDITION_REQUIRED_IF_MATCH",
      "category": "PRECONDITION_REQUIRED",
      "status": 428,
      "type": "https://api.workflow-platform.example/problems/if-match-required",
      "title": "Draft precondition required",
