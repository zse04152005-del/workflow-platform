    "store": "control-plane/src/main/java/com/workflowplatform/controlplane/definition/internal/JdbcWorkflowDraftStore.java",
    "idempotencyRecords": "control-plane/src/main/java/com/workflowplatform/controlplane/definition/internal/JdbcIdempotencyRecords.java",
    "jsonConfiguration": "control-plane/src/main/java/com/workflowplatform/controlplane/definition/internal/WorkflowDraftJacksonConfiguration.java",
