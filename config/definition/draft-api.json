  "requirement": "REQ-DEF-001",
  "operations": [
    { "operationId": "createWorkflow", "method": "post", "path": "/api/v1/workflows", "successStatus": "201", "headers": ["Idempotency-Key"] },
    { "operationId": "getWorkflow", "method": "get", "path": "/api/v1/workflows/{workflowId}", "successStatus": "200", "headers": [] },
    { "operationId": "updateWorkflowDraft", "method": "put", "path": "/api/v1/workflows/{workflowId}/draft", "successStatus": "200", "headers": ["Idempotency-Key", "If-Match"] }
  ],
  "etag": {
    "prefix": "wf-draft:",
    "strongOnly": true,
    "binds": ["workflowId", "draftRevision", "draftChecksum"],
    "reject": ["missing", "weak", "wildcard", "list", "malformed", "stale", "other-workflow"],
    "missingStatus": 428,
    "mismatchStatus": 412
  },
  "idempotency": {
    "table": "idempotency_record",
    "scope": ["workflow:create", "workflow:draft:update:{workflowId}"],
    "keyTransport": { "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._~-]+$" },
    "keyStoredAs": "sha256",
    "requestStoredAs": "sha256",
    "ttlHours": 24,
    "expiredKeyAction": "reset-same-row-after-expiry-under-lock",
    "sameTransactionAsWrite": true,
    "differentRequestStatus": 409
  },
  "tenantBoundary": {
    "source": "trusted-request-attribute",
    "clientTenantHeaderAllowed": false,
    "databaseContextFunction": "public.app_set_tenant_context",
    "forcedRlsRequired": true,
    "crossTenantReadStatus": 404
  },
  "persistence": {
    "migration": "V6__add_workflow_draft_api_fields.sql",
    "initialRevision": 1,
    "updatePredicates": ["id", "draft_revision", "draft_checksum"],
    "atomicChanges": ["draft_dsl", "draft_revision", "draft_checksum", "updated_at", "updated_by", "version"]
  },
  "problemCodes": {
