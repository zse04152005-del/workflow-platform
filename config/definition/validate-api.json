{
  "schemaVersion": 1,
  "contractVersion": "1.0.0",
  "task": "G3-07",
  "requirements": ["REQ-DSL-001", "REQ-DEF-001"],
  "operation": {
    "operationId": "validateWorkflow",
    "method": "post",
    "path": "/api/v1/workflows/{workflowId}/validate",
    "successStatus": "200",
    "notFoundStatus": "404",
    "requiredHeaders": ["Idempotency-Key"],
    "writesIdempotencyRecord": false
