# Local application runtime only. Copy to .env; never reuse in shared or production environments.
SPRING_PROFILES_ACTIVE=local
CONTROL_PLANE_PORT=8080

WORKFLOW_DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/workflow_platform
WORKFLOW_DATABASE_USERNAME=workflow_app
WORKFLOW_DATABASE_PASSWORD=workflow-app-local-only-change-me
WORKFLOW_DATABASE_MIGRATION_USERNAME=workflow_migrator
WORKFLOW_DATABASE_MIGRATION_PASSWORD=workflow-migrator-local-only-change-me
WORKFLOW_DATABASE_APPLICATION_ROLE=workflow_app
WORKFLOW_DATABASE_PLATFORM_ADMIN_ROLE=workflow_platform_admin

WORKFLOW_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
WORKFLOW_KAFKA_PUBLISHER_ENABLED=true
WORKFLOW_TASK_READY_TOPIC=workflow.task.ready
WORKFLOW_EVENTS_TOPIC=workflow.events

WORKFLOW_REDIS_HOST=127.0.0.1
WORKFLOW_REDIS_PORT=16379
WORKFLOW_REDIS_PASSWORD=redis-local-only-change-me

WORKFLOW_S3_ENDPOINT=http://127.0.0.1:19000
WORKFLOW_S3_ACCESS_KEY=minio_local_admin
WORKFLOW_S3_SECRET_KEY=minio-local-only-change-me
WORKFLOW_S3_BUCKET=workflow-payloads
WORKFLOW_PAYLOAD_INLINE_THRESHOLD_BYTES=65536

WORKFLOW_OIDC_ISSUER=http://127.0.0.1:8081/realms/workflow-platform
WORKFLOW_OTEL_ENDPOINT=http://127.0.0.1:4317
WORKFLOW_WORKER_CONCURRENCY=4
WORKFLOW_WORKER_KAFKA_ENABLED=true
WORKFLOW_WORKER_CONSUMER_NAME=workflow-worker
WORKFLOW_WORKER_INSTANCE_ID=workflow-worker-local-1
